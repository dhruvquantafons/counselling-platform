generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Counsellor {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  specialisation String
  languages      String[]
  fee            Decimal
  bio            String?
  approved       Boolean  @default(false)
  createdAt      DateTime @default(now())

  availability   Availability[]
  bookings       Booking[]
}

model Availability {
  id           String     @id @default(uuid())
  counsellorId String
  counsellor   Counsellor @relation(fields: [counsellorId], references: [id])
  startTime    DateTime   // stored in UTC
  endTime      DateTime
  isBooked     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  // Prevents double-booking at DB level (AC-4 for this task)
  @@unique([counsellorId, startTime])
}

model Booking {
  id                   String     @id @default(uuid())
  counsellorId         String
  counsellor           Counsellor @relation(fields: [counsellorId], references: [id])
  visitorName          String
  visitorEmail         String
  visitorPhone         String
  startTime            DateTime
  status               BookingStatus @default(PENDING)
  roomId               String?    @unique
  sessionDurationMinutes Int      @default(50)
  createdAt            DateTime   @default(now())

  payment              Payment?
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Payment {
  id            String   @id @default(uuid())
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id])
  amount        Decimal
  status        PaymentStatus @default(INITIATED)
  gatewayOrderId String?
  gatewayPaymentId String?
  createdAt     DateTime @default(now())
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
}

model Notification {
  id           String              @id @default(uuid())
  bookingId    String
  booking      Booking             @relation(fields: [bookingId], references: [id])
  type         NotificationType
  channel      NotificationChannel
  scheduledFor DateTime
  status       NotificationStatus  @default(PENDING)
  isRead       Boolean             @default(false)
  readAt       DateTime?
  sentAt       DateTime?
  error        String?
  createdAt    DateTime            @default(now())

  @@index([status, scheduledFor])
  @@index([bookingId, channel])
}

enum NotificationType {
  PAYMENT_RECEIPT
  BOOKING_CONFIRMATION
  REMINDER_24H
  REMINDER_1H
  REMINDER_10MIN
  RESCHEDULE
  CANCELLATION
  REFUND
}

enum NotificationChannel {
  EMAIL
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model PushSubscription {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}