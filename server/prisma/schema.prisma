generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Counsellor {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  specialisation String
  languages      String[]
  fee            Decimal
  bio            String?
  approved       Boolean  @default(false)
  createdAt      DateTime @default(now())

  availability   Availability[]
  bookings       Booking[]
}

model Availability {
  id           String     @id @default(uuid())
  counsellorId String
  counsellor   Counsellor @relation(fields: [counsellorId], references: [id])
  startTime    DateTime   // stored in UTC
  endTime      DateTime
  isBooked     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  // Prevents double-booking at DB level (AC-4 for this task)
  @@unique([counsellorId, startTime])
}

model Booking {
  id                   String     @id @default(uuid())
  counsellorId         String
  counsellor           Counsellor @relation(fields: [counsellorId], references: [id])
  visitorName          String
  visitorEmail         String
  visitorPhone         String
  startTime            DateTime
  status               BookingStatus @default(PENDING)
  roomId               String?    @unique
  sessionDurationMinutes Int      @default(50)
  createdAt            DateTime   @default(now())

  payment              Payment?
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Payment {
  id            String   @id @default(uuid())
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id])
  amount        Decimal
  status        PaymentStatus @default(INITIATED)
  gatewayOrderId String?
  gatewayPaymentId String?
  createdAt     DateTime @default(now())
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
}

model Notification {
  id           String              @id @default(uuid())
  bookingId    String
  booking      Booking             @relation(fields: [bookingId], references: [id])
  type         NotificationType
  channel      NotificationChannel
  scheduledFor DateTime
  status       NotificationStatus  @default(PENDING)
  isRead       Boolean             @default(false)
  readAt       DateTime?
  sentAt       DateTime?
  error        String?
  createdAt    DateTime            @default(now())

  @@index([status, scheduledFor])
  @@index([bookingId, channel])
}

enum NotificationType {
  PAYMENT_RECEIPT
  BOOKING_CONFIRMATION
  REMINDER_24H
  REMINDER_1H
  REMINDER_10MIN
  RESCHEDULE
  CANCELLATION
  REFUND
}

enum NotificationChannel {
  EMAIL
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model PushSubscription {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CounsellorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REMOVED
}

model Counsellor {
  id             String           @id @default(uuid())
  name           String
  email          String           @unique
  phone          String?
  specialisation String
  qualifications String?
  languages      String[]
  fee            Decimal
  bio            String?
  photoUrl       String?
  passwordHash   String?
  approved       Boolean          @default(false)
  status         CounsellorStatus @default(PENDING)
  createdAt      DateTime         @default(now())

  availability   Availability[]
  bookings       Booking[]
}

model Availability {
  id           String     @id @default(uuid())
  counsellorId String
  counsellor   Counsellor @relation(fields: [counsellorId], references: [id])
  startTime    DateTime   // stored in UTC
  endTime      DateTime
  isBooked     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  // Prevents double-booking at DB level (AC-4 for this task)
  @@unique([counsellorId, startTime])
}

model Booking {
  id                   String        @id @default(uuid())
  counsellorId         String
  counsellor           Counsellor    @relation(fields: [counsellorId], references: [id])
  visitorName          String
  visitorEmail         String
  visitorPhone         String
  startTime            DateTime
  status               BookingStatus @default(PENDING)
  roomId               String?       @unique
  sessionDurationMinutes Int         @default(50)
  createdAt            DateTime      @default(now())

  payment              Payment?

  @@unique([counsellorId, startTime]) // enforced again here at booking level
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Payment {
  id               String        @id @default(uuid())
  bookingId        String        @unique
  booking          Booking       @relation(fields: [bookingId], references: [id])
  amount           Decimal
  status           PaymentStatus @default(INITIATED)
  gatewayOrderId   String?
  gatewayPaymentId String?
  createdAt        DateTime      @default(now())
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
}

// ─── Section 3.7: Admin Panel Models ──────────────────────────────────────────

model StaticPage {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  actor      String   // "admin" or a name
  action     String   // e.g. "APPROVE_COUNSELLOR", "SUSPEND_COUNSELLOR"
  targetType String   // "Counsellor", "Booking", "Payment", "StaticPage", "Faq"
  targetId   String
  detail     String?
  createdAt  DateTime @default(now())
}
